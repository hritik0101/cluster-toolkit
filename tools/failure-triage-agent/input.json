  "repo": "AdarshK15/cluster-toolkit",
  "commit": "64fd18c50d6cd05abe4ab4138559cd06f36e6480",
  "analyzer_loops": 10,
  "commands": {
    "gke": [
      "kubectl get nodes -o wide",
      "kubectl top nodes",
      "kubectl get componentstatuses",
      "kubectl get pods -A --field-selector=status.phase!=Running",
      "kubectl get events --sort-by=.lastTimestamp -A",
      "kubectl describe nodes",
      "kubectl get events -A -o yaml",
      "kubectl cluster-info dump"
    ],
    "slurm": {
      "controller_login": [
        "sinfo -R -o \"%20N %10T %20H %E\"",
        "sinfo -O NodeList,StateLong,Gres,GresUsed -N",
        "squeue -t PENDING -h -o \"%i\" | awk '{print $1}' | head -n 1 | xargs -r scontrol show job | grep -E \"JobId|JobState|Reason|TRES_req|ExcNodeList\"",
        "sinfo -R -h -o \"%N\" | awk -F',' '{print $1}' | awk '{print $1}' | head -n 1 | xargs -r scontrol show node | grep -E \"NodeName|State|Reason|Gres|ActiveFeatures|Comment\"",
        "sacct -X --state=FAILED,NODE_FAIL,OUT_OF_MEMORY -S today -o JobID,User,Node,ExitCode,State",
        "systemctl status munge slurmctld slurmdbd --no-pager",
        "sudo journalctl -p err..emerg -b --no-pager",
        "sudo tail -n 200 /var/log/slurm/slurmctld.log",
        "free -m",
        "df -h"
      ],
      "nodeset": [
        "nvidia-smi",
        "sudo systemctl status slurmd --no-pager -l",
        "sudo dmesg -T | grep -iE \"oom|killed|xid|nvrm|nvidia\" | tail -n 20",
        "sudo fuser -v /dev/nvidia*",
        "sudo journalctl -p err..emerg -b --no-pager",
        "sudo tail -n 200 /var/log/slurm/slurmd.log",
        "free -m",
        "df -h",
        "scontrol show node $(hostname)",
        "uptime"
      ]
    }
  }
}
